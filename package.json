{
  "name": "dsh-wsl-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Desktop WSL execution world: add a WSL workspace and run every tool inside the distribution.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "verify": "node scripts/verify-all.mjs",
    "verify:live": "node scripts/verify-all.mjs --live",
    "verify:client": "node scripts/verify-client-ui.mjs && node scripts/verify-client-dom.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wsl",
    "agent-preset",
    "execution-world"
  ],
  "license": "MIT"
}
