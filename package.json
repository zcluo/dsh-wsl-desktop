{
  "name": "dsh-wsl-desktop",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zcluo/dsh-wsl-desktop.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "manifestVersion": 1,
  "license": "MIT",
  "description": "DSH Desktop WSL execution world: add a WSL workspace and run every tool inside the distribution."
}
